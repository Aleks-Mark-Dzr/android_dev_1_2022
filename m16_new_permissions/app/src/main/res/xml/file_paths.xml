<?xml version="1.0" encoding="utf-8"?>
<!-- Пути, которые FileProvider разрешает отдавать наружу: временная папка снимков камеры
     и папка сохранённых фотографий, которыми пользователь делится из диалога метки -->
<paths>
    <cache-path
        name="attraction_photos_temp"
        path="attraction_photos_temp/" />

    <files-path
        name="attraction_photos"
        path="attraction_photos/" />
</paths>
