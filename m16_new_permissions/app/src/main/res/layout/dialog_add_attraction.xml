<?xml version="1.0" encoding="utf-8"?>
<!-- Содержимое диалога метки прокручивается: с фотографией оно не помещается на невысоких экранах -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/nameEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/attraction_name_hint"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/descriptionEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/attraction_description_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="3"
            android:gravity="top|start"
            android:importantForAutofill="no" />

        <!-- Координаты метки: их можно поправить вручную -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/latitudeEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/attraction_latitude_hint"
                android:inputType="numberDecimal|numberSigned"
                android:maxLines="1"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/longitudeEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="@string/attraction_longitude_hint"
                android:inputType="numberDecimal|numberSigned"
                android:maxLines="1"
                android:importantForAutofill="no" />
        </LinearLayout>

        <!-- Фотография метки: снимок с камеры или изображение из галереи -->
        <ImageView
            android:id="@+id/photoImageView"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:contentDescription="@string/attraction_photo_description"
            android:visibility="gone" />

        <TextView
            android:id="@+id/photoHintTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/attraction_photo_empty"
            android:textStyle="italic" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/addPhotoButton"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_add_photo" />

            <Button
                android:id="@+id/removePhotoButton"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/action_remove_photo"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Отправка метки и её фотографии в другое приложение -->
        <Button
            android:id="@+id/shareButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_share" />

        <!-- Подсказка о том, что метку можно перетащить прямо по карте -->
        <TextView
            android:id="@+id/dragHintTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/edit_marker_drag_hint"
            android:textStyle="italic"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
