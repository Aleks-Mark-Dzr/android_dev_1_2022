<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MapView для отображения карты -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Кнопка для увеличения зума -->
    <Button
        android:id="@+id/zoomInButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp" />

    <!-- Кнопка для уменьшения зума -->
    <Button
        android:id="@+id/zoomOutButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:layout_below="@id/zoomInButton"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp" />

    <!-- Поиск сохранённой метки: по набранным символам предлагаются подходящие названия -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/zoomInButton"
        android:layout_margin="16dp"
        android:background="@drawable/search_field_background"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <AutoCompleteTextView
            android:id="@+id/searchAutoCompleteTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_attraction_hint"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:completionThreshold="1"
            android:dropDownVerticalOffset="4dp"
            android:importantForAutofill="no" />

        <!-- Очистка поля: возвращает карту к обычному виду одним нажатием -->
        <ImageButton
            android:id="@+id/clearSearchButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_clear"
            android:scaleType="centerInside"
            android:contentDescription="@string/search_attraction_clear"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Кнопка для перехода к текущему местоположению -->
    <Button
        android:id="@+id/currentLocationButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Location"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp" />

    <!-- Резервная копия меток: выгрузка в файл и восстановление из него -->
    <Button
        android:id="@+id/backupButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/backup_button"
        android:layout_above="@id/addMarkerButton"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp" />

    <!-- Кнопка для добавления метки с текущей геопозицией -->
    <Button
        android:id="@+id/addMarkerButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_marker_button"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_margin="16dp" />
</RelativeLayout>